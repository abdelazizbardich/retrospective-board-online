# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard password (default: admin)
ADMIN_PASSWORD=
NEXT_PUBLIC_SITE_URL=

# vercel storage
# OIDC (recommended on Vercel): BLOB_STORE_ID + VERCEL_OIDC_TOKEN (auto on deploy; run `vercel env pull` locally)
# Fallback: BLOB_READ_WRITE_TOKEN (explicit token bypasses OIDC when development env isn't linked)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
BLOB_WEBHOOK_PUBLIC_KEY=

# fal.ai (blog cover image generation)
FAL_KEY=

# Vercel Cron (optional; secures /api/cron/publish-blog)
CRON_SECRET=

# SMTP (contact form)
MAILER=smtp
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=  # optional; defaults to SITE_EMAIL