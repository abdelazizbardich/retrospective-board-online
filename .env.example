# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Session signing (required in production — use long random values)
# Prefer dedicated secrets; SESSION_SECRET is a shared fallback for board/user tokens.
SESSION_SECRET=
BOARD_SESSION_SECRET=
USER_SESSION_SECRET=

# Admin dashboard (required in production — no defaults)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=

# Optional: Bearer token for automated blog post creation (POST /api/blog)
BLOG_API_KEY=

# vercel storage
# OIDC (recommended on Vercel): BLOB_STORE_ID + VERCEL_OIDC_TOKEN (auto on deploy; run `vercel env pull` locally)
# Fallback: BLOB_READ_WRITE_TOKEN (explicit token bypasses OIDC when development env isn't linked)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
BLOB_WEBHOOK_PUBLIC_KEY=

# fal.ai (blog cover image generation)
FAL_KEY=

# Vercel Cron (required to enable /api/cron/publish-blog)
CRON_SECRET=

# SMTP (contact form)
MAILER=smtp
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=  # optional; defaults to SITE_EMAIL
